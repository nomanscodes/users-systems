{
  "info": {
    "name": "user-system",
    "_postman_id": "sms-saas-tenants-v2",
    "description": "All API endpoints for the School Management SaaS user system.\n\nBase URL: http://localhost:3000/api/v1\n\nPhase 0.1 — Tenants\nPhase 0.2 — Auth\nPhase 0.3 — Academics\nPhase 0.4A — RBAC (Roles & Permissions)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "BASE_URL", "value": "http://localhost:3000/api/v1", "type": "string" },
    { "key": "ACCESS_TOKEN", "value": "", "type": "string", "description": "Auto-set after login" },
    { "key": "REFRESH_TOKEN", "value": "", "type": "string", "description": "Auto-set after login" },
    { "key": "TENANT_ID", "value": "", "type": "string", "description": "Set after creating a tenant" },
    { "key": "ROLE_ID", "value": "", "type": "string", "description": "Set after creating a role" },
    { "key": "PERMISSION_ID", "value": "", "type": "string", "description": "Set from GET /permissions response" },
    { "key": "USER_ID", "value": "", "type": "string", "description": "Set for staff user operations" }
  ],
  "item": [
    {
      "name": "Phase 0.2 — Authentication",
      "description": "Login, refresh, logout, and current user profile.",
      "item": [
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["var j = pm.response.json();", "if (j && j.success && j.data) {", "  pm.collectionVariables.set('ACCESS_TOKEN', j.data.accessToken);", "  pm.collectionVariables.set('REFRESH_TOKEN', j.data.refreshToken);", "}"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{BASE_URL}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@greenvalley.edu\",\n  \"password\": \"Admin@1234\"\n}", "options": { "raw": { "language": "json" } } },
            "description": "Returns accessToken + refreshToken. Tokens auto-saved to collection variables."
          }
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }],
            "url": "{{BASE_URL}}/auth/me",
            "description": "Returns the profile of the currently authenticated user."
          }
        },
        {
          "name": "Refresh Token",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["var j = pm.response.json();", "if (j && j.success && j.data) {", "  pm.collectionVariables.set('ACCESS_TOKEN', j.data.accessToken);", "  pm.collectionVariables.set('REFRESH_TOKEN', j.data.refreshToken);", "}"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{BASE_URL}}/auth/refresh",
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{REFRESH_TOKEN}}\"\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Logout",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 200) {", "  pm.collectionVariables.unset('ACCESS_TOKEN');", "  pm.collectionVariables.unset('REFRESH_TOKEN');", "}"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }],
            "url": "{{BASE_URL}}/auth/logout",
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{REFRESH_TOKEN}}\"\n}", "options": { "raw": { "language": "json" } } }
          }
        }
      ]
    },
    {
      "name": "Phase 0.1 — Tenants (Public)",
      "description": "No auth required.",
      "item": [
        {
          "name": "Self-Register School (Public)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{BASE_URL}}/tenants/register",
            "body": { "mode": "raw", "raw": "{\n  \"schoolName\": \"Green Valley Academy\",\n  \"slug\": \"green-valley-academy\",\n  \"schoolEmail\": \"info@greenvalley.edu\",\n  \"schoolPhone\": \"+8801712345678\",\n  \"address\": \"123 School Road, Dhaka\",\n  \"adminFirstName\": \"John\",\n  \"adminLastName\": \"Doe\",\n  \"adminEmail\": \"admin@greenvalley.edu\",\n  \"adminPassword\": \"Admin@1234\",\n  \"adminPhone\": \"+8801712345679\"\n}", "options": { "raw": { "language": "json" } } },
            "description": "Public registration. Status auto-set to TRIAL. No auth required."
          }
        }
      ]
    },
    {
      "name": "Phase 0.1 — Tenants (Super Admin Only)",
      "description": "Requires SUPER_ADMIN JWT.",
      "item": [
        {
          "name": "Create Tenant (Super Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }],
            "url": "{{BASE_URL}}/tenants",
            "body": { "mode": "raw", "raw": "{\n  \"schoolName\": \"Sunrise International School\",\n  \"slug\": \"sunrise-international\",\n  \"schoolEmail\": \"info@sunrise.edu\",\n  \"schoolPhone\": \"+8801899887766\",\n  \"address\": \"456 Avenue Road, Chittagong\",\n  \"adminFirstName\": \"Jane\",\n  \"adminLastName\": \"Smith\",\n  \"adminEmail\": \"admin@sunrise.edu\",\n  \"adminPassword\": \"Admin@5678\",\n  \"adminPhone\": \"+8801899887767\",\n  \"status\": \"ACTIVE\"\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "List All Tenants",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }],
            "url": { "raw": "{{BASE_URL}}/tenants?page=1&limit=20", "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "20" }, { "key": "search", "value": "", "disabled": true }, { "key": "status", "value": "ACTIVE", "disabled": true }] }
          }
        },
        {
          "name": "Get Tenant by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }],
            "url": "{{BASE_URL}}/tenants/{{TENANT_ID}}"
          }
        },
        {
          "name": "Update Tenant Details",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }],
            "url": "{{BASE_URL}}/tenants/{{TENANT_ID}}",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Green Valley Academy (Updated)\",\n  \"email\": \"contact@greenvalley.edu\",\n  \"phone\": \"+8801712000000\",\n  \"address\": \"789 New Street, Dhaka\"\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Update Tenant Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }],
            "url": "{{BASE_URL}}/tenants/{{TENANT_ID}}/status",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"ACTIVE\"\n}", "options": { "raw": { "language": "json" } } },
            "description": "Valid values: TRIAL | ACTIVE | SUSPENDED"
          }
        }
      ]
    },
    {
      "name": "Phase 0.3 — Academics",
      "description": "Tenant-scoped. Requires School Admin JWT + academics permission.",
      "item": [
        {
          "name": "Branches",
          "item": [
            { "name": "Create Branch", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/branches", "body": { "mode": "raw", "raw": "{\n  \"name\": \"Main Campus\",\n  \"address\": \"123 Campus Drive\",\n  \"contactNumber\": \"+8801700000001\"\n}", "options": { "raw": { "language": "json" } } } } },
            { "name": "Get All Branches", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/branches" } },
            { "name": "Get Branch by ID", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/branches/<UUID>" } },
            { "name": "Update Branch", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/branches/<UUID>", "body": { "mode": "raw", "raw": "{\n  \"name\": \"Main Campus (Updated)\"\n}", "options": { "raw": { "language": "json" } } } } },
            { "name": "Delete Branch", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/branches/<UUID>" } }
          ]
        },
        {
          "name": "Sessions",
          "item": [
            { "name": "Create Session", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/sessions", "body": { "mode": "raw", "raw": "{\n  \"name\": \"2026-2027\",\n  \"startDate\": \"2026-01-01\",\n  \"endDate\": \"2026-12-31\",\n  \"isCurrent\": true\n}", "options": { "raw": { "language": "json" } } } } },
            { "name": "Get All Sessions", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/sessions" } },
            { "name": "Get Session by ID", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/sessions/<UUID>" } },
            { "name": "Update Session", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/sessions/<UUID>", "body": { "mode": "raw", "raw": "{\n  \"name\": \"2026-2027 (Updated)\",\n  \"isCurrent\": false\n}", "options": { "raw": { "language": "json" } } } } },
            { "name": "Delete Session", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/sessions/<UUID>" } }
          ]
        },
        {
          "name": "Classes",
          "item": [
            { "name": "Create Class", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/classes", "body": { "mode": "raw", "raw": "{\n  \"name\": \"Class 10\",\n  \"numericValue\": 10\n}", "options": { "raw": { "language": "json" } } } } },
            { "name": "Get All Classes", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/classes" } },
            { "name": "Get Class by ID", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/classes/<UUID>" } },
            { "name": "Update Class", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/classes/<UUID>", "body": { "mode": "raw", "raw": "{\n  \"name\": \"Class 10 (Revised)\"\n}", "options": { "raw": { "language": "json" } } } } },
            { "name": "Delete Class", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/classes/<UUID>" } }
          ]
        },
        {
          "name": "Groups",
          "item": [
            { "name": "Create Group", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/groups", "body": { "mode": "raw", "raw": "{\n  \"name\": \"Science\"\n}", "options": { "raw": { "language": "json" } } } } },
            { "name": "Get All Groups", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/groups" } },
            { "name": "Get Group by ID", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/groups/<UUID>" } },
            { "name": "Update Group", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/groups/<UUID>", "body": { "mode": "raw", "raw": "{\n  \"name\": \"Humanities\"\n}", "options": { "raw": { "language": "json" } } } } },
            { "name": "Delete Group", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/groups/<UUID>" } }
          ]
        },
        {
          "name": "Sections",
          "item": [
            { "name": "Create Section", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/sections", "body": { "mode": "raw", "raw": "{\n  \"name\": \"Section A\"\n}", "options": { "raw": { "language": "json" } } } } },
            { "name": "Get All Sections", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/sections" } },
            { "name": "Get Section by ID", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/sections/<UUID>" } },
            { "name": "Update Section", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/sections/<UUID>", "body": { "mode": "raw", "raw": "{\n  \"name\": \"Section B\"\n}", "options": { "raw": { "language": "json" } } } } },
            { "name": "Delete Section", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/sections/<UUID>" } }
          ]
        },
        {
          "name": "Subjects",
          "item": [
            { "name": "Create Subject", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/subjects", "body": { "mode": "raw", "raw": "{\n  \"name\": \"Physics\",\n  \"code\": \"PHY-101\",\n  \"type\": \"MANDATORY\"\n}", "options": { "raw": { "language": "json" } } } } },
            { "name": "Get All Subjects", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/subjects" } },
            { "name": "Get Subject by ID", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/subjects/<UUID>" } },
            { "name": "Update Subject", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/subjects/<UUID>", "body": { "mode": "raw", "raw": "{\n  \"name\": \"Advanced Physics\"\n}", "options": { "raw": { "language": "json" } } } } },
            { "name": "Delete Subject", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/subjects/<UUID>" } }
          ]
        },
        {
          "name": "Batches (Classrooms)",
          "item": [
            { "name": "Create Batch", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/batches", "body": { "mode": "raw", "raw": "{\n  \"branchId\": \"<UUID>\",\n  \"sessionId\": \"<UUID>\",\n  \"classId\": \"<UUID>\",\n  \"groupId\": \"<UUID_OR_OMIT>\",\n  \"sectionId\": \"<UUID_OR_OMIT>\"\n}", "options": { "raw": { "language": "json" } } } } },
            { "name": "Get All Batches", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/batches" } },
            { "name": "Get Batch by ID", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/batches/<UUID>" } },
            { "name": "Resolve Batch (Cascade Lookup)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/batches/resolve", "body": { "mode": "raw", "raw": "{\n  \"branchId\": \"<UUID>\",\n  \"sessionId\": \"<UUID>\",\n  \"classId\": \"<UUID>\",\n  \"groupId\": \"<UUID_OR_OMIT>\",\n  \"sectionId\": \"<UUID_OR_OMIT>\"\n}", "options": { "raw": { "language": "json" } } }, "description": "Translates cascade dropdown selections into a single batchId." } },
            { "name": "Delete Batch", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/batches/<UUID>" } }
          ]
        },
        {
          "name": "Subject Allocations",
          "item": [
            { "name": "Create Subject Allocation", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/subject-allocations", "body": { "mode": "raw", "raw": "{\n  \"classId\": \"<UUID>\",\n  \"groupId\": \"<UUID_OR_OMIT>\",\n  \"subjectId\": \"<UUID>\"\n}", "options": { "raw": { "language": "json" } } } } },
            { "name": "Get All Subject Allocations", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/subject-allocations" } },
            { "name": "Delete Subject Allocation", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }], "url": "{{BASE_URL}}/academics/subject-allocations/<UUID>" } }
          ]
        }
      ]
    },
    {
      "name": "Phase 0.4A — Permissions (System)",
      "description": "Read-only. Lists all 20 system permissions. Requires roles:read permission.",
      "item": [
        {
          "name": "Get All Permissions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }],
            "url": "{{BASE_URL}}/permissions",
            "description": "Returns all 20 global system permissions (e.g. fees:read, attendance:write).\nRequires: JWT + TenantScope + roles:read permission.\nSave a permission id to PERMISSION_ID variable for use in role assignment."
          }
        }
      ]
    },
    {
      "name": "Phase 0.4A — Roles (CRUD)",
      "description": "School Admin manages job roles for their tenant. Requires roles:read or roles:write permission.",
      "item": [
        {
          "name": "Create Role",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["var j = pm.response.json();", "if (j && j.id) { pm.collectionVariables.set('ROLE_ID', j.id); }"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }],
            "url": "{{BASE_URL}}/roles",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Teacher\",\n  \"description\": \"Can manage classroom, attendance and exams\"\n}", "options": { "raw": { "language": "json" } } },
            "description": "Creates a custom role scoped to the authenticated user's tenant.\nRole ID is auto-saved to ROLE_ID collection variable after creation."
          }
        },
        {
          "name": "Get All Roles",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }],
            "url": "{{BASE_URL}}/roles",
            "description": "Lists all roles for this tenant (both custom and system roles)."
          }
        },
        {
          "name": "Get Role by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }],
            "url": "{{BASE_URL}}/roles/{{ROLE_ID}}",
            "description": "Returns a single role with its assigned permissions included."
          }
        },
        {
          "name": "Update Role",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }],
            "url": "{{BASE_URL}}/roles/{{ROLE_ID}}",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Senior Teacher\",\n  \"description\": \"Updated description\"\n}", "options": { "raw": { "language": "json" } } },
            "description": "Update role name or description. Cannot modify system roles (isSystemRole: true)."
          }
        },
        {
          "name": "Delete Role",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }],
            "url": "{{BASE_URL}}/roles/{{ROLE_ID}}",
            "description": "Deletes role. Cannot delete system roles. Cascades to role_permissions and user_roles."
          }
        }
      ]
    },
    {
      "name": "Phase 0.4A — Role Permissions",
      "description": "Assign or remove permissions from a role.",
      "item": [
        {
          "name": "Assign Permissions to Role",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }],
            "url": "{{BASE_URL}}/roles/{{ROLE_ID}}/permissions",
            "body": { "mode": "raw", "raw": "{\n  \"permissionIds\": [\n    \"<PERMISSION_UUID_1>\",\n    \"<PERMISSION_UUID_2>\"\n  ]\n}", "options": { "raw": { "language": "json" } } },
            "description": "Attach one or more permissions to a role.\nGet permission UUIDs from GET /permissions first.\nDuplicates are safely ignored."
          }
        },
        {
          "name": "Remove Permission from Role",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }],
            "url": "{{BASE_URL}}/roles/{{ROLE_ID}}/permissions/{{PERMISSION_ID}}",
            "description": "Removes a single permission from the role. Replace PERMISSION_ID in the URL."
          }
        }
      ]
    }
  ]
}